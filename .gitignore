.DS_Store

# Data: never commit records. Keep directory READMEs and placeholders.
# Aggregate reports (JSON/CSV/Markdown without review records) are tracked.
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep
!data/reports/**/*.md
!data/reports/**/*.json
!data/reports/**/*.csv

# Model artifacts and large outputs
*.parquet
*.jsonl
*.jsonl.gz
*.pt
*.ckpt
*.npy
*.npz
results/**/*.parquet
