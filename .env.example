# Copy to .env (untracked) and adjust. Process environment variables take precedence.

# Directory holding raw/, interim/, processed/, splits/, attack_simulations/.
# Keep large data outside OneDrive or other synced folders.
# Leave unset to use ./data inside the repository.
VOUCHREC_DATA_ROOT=C:\VouchRecData\data

# API Server configuration
VOUCHREC_API_HOST=127.0.0.1
VOUCHREC_API_PORT=8000
VOUCHREC_API_RELOAD=false

# CORS Origins (comma-separated allowed browser origins)
VOUCHREC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional: only needed for gated Hugging Face datasets (none are used yet).
# HF_TOKEN=
